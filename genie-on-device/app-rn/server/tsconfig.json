{
  "//": "CommonJS on purpose: the server ships to the board as plain .js with no package.json alongside it, and CJS needs no module-type declaration or file extensions in imports.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2023", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["*.ts"],
  "exclude": ["dist", "node_modules"]
}
